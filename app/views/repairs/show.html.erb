<% content_for :title, "Repair ##{@repair.id}" %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="text-body-secondary mb-1">Repair</p>
    <h1>Repair #<%= @repair.id %></h1>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "All repairs", repairs_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Edit repair", edit_repair_path(@repair), class: "btn btn-primary" %>
    <%= button_to "Delete repair", @repair, method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete repair ##{@repair.id}?" } %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Bike</dt>
  <dd class="col-sm-9"><%= link_to "#{@repair.bike.make} #{@repair.bike.model}", bike_path(@repair.bike) %></dd>
  <dt class="col-sm-3">Customer</dt>
  <dd class="col-sm-9"><%= link_to @repair.bike.customer.name, customer_path(@repair.bike.customer) %></dd>
  <dt class="col-sm-3">Status</dt>
  <dd class="col-sm-9"><span class="badge text-bg-secondary"><%= @repair.status.humanize %></span></dd>
  <dt class="col-sm-3">Promised on</dt>
  <dd class="col-sm-9"><%= @repair.promised_on.strftime("%-d %B %Y") %></dd>
  <dt class="col-sm-3">Customer approved</dt>
  <dd class="col-sm-9"><%= @repair.customer_approved.nil? ? "Pending" : (@repair.customer_approved ? "Yes" : "No") %></dd>
  <dt class="col-sm-3">Approved at</dt>
  <dd class="col-sm-9"><%= @repair.approved_at&.to_fs(:long) || "Not approved" %></dd>
  <dt class="col-sm-3">Quoted at</dt>
  <dd class="col-sm-9"><%= @repair.quoted_at&.to_fs(:long) || "Not quoted" %></dd>
  <dt class="col-sm-3">Handed back</dt>
  <dd class="col-sm-9"><%= @repair.handed_back_at&.to_fs(:long) || "Not handed back" %></dd>
</dl>

<h2 class="h4 mt-5">Intake photos</h2>
<% if @repair.photos.attached? %>
  <div class="d-flex flex-wrap gap-3">
    <% @repair.photos.each do |photo| %>
      <figure class="mb-0">
        <%= link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener" do %>
          <%= image_tag photo.variant(:large), alt: "#{@repair.bike.make} #{@repair.bike.model}, repair ##{@repair.id} intake photo", class: "img-fluid rounded" %>
        <% end %>
        <figcaption class="mt-2">
          <%= button_to "Remove photo", photo_repair_path(@repair, photo_id: photo.id), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Remove this intake photo?" } %>
        </figcaption>
      </figure>
    <% end %>
  </div>
<% else %>
  <p class="text-body-secondary">No intake photos have been added.</p>
<% end %>

<h2 class="h4 mt-5">Diagnosis</h2>
<% if @repair.diagnosis.present? %>
  <div class="border rounded p-3"><%= @repair.diagnosis %></div>
<% else %>
  <p class="text-body-secondary">No diagnosis has been written.</p>
<% end %>

<h2 class="h4 mt-5">Services charged</h2>
<% if @repair.repair_line_items.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Service</th><th>Price charged</th></tr></thead>
      <tbody><%= render partial: "repairs/repair_line_item", collection: @repair.repair_line_items %></tbody>
      <tfoot><tr><th>Total</th><th><%= number_to_currency(@repair.total) %></th></tr></tfoot>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">No services have been charged.</p>
<% end %>