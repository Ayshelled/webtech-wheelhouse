<% content_for :title, "Repairs" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Repairs</h1>
  <%= link_to "New repair", new_repair_path, class: "btn btn-primary" %>
</div>

<% if @repairs.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Photo</th><th>Repair</th><th>Bike</th><th>Customer</th><th>Diagnosis</th><th>Status</th><th>Promised on</th></tr></thead>
      <tbody><%= render @repairs %></tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">No repairs found.</p>
<% end %>