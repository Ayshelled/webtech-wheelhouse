<% content_for :title, "Update your password" %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1 class="mb-4">Update your password</h1>

    <%= render "shared/form_errors", record: @user %>

    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <div class="mb-3">
        <%= form.label :password, "New password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
          maxlength: 72, class: field_class(@user, :password) %>
        <div class="form-text">Use at least 10 characters.</div>
        <%= field_error_messages(@user, :password) %>
      </div>
      <div class="mb-3">
        <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
          maxlength: 72, class: field_class(@user, :password_confirmation) %>
        <%= field_error_messages(@user, :password_confirmation) %>
      </div>
      <%= form.submit "Save password", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
