<% content_for :title, "Bikes" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Bikes</h1>
  <%= link_to "New bike", new_bike_path, class: "btn btn-primary" %>
</div>

<% if @bikes.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Bike</th><th>Owner</th><th>Serial number</th></tr></thead>
      <tbody><%= render @bikes %></tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">No bikes found.</p>
<% end %>