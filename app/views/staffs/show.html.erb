<% content_for :title, @staff.name %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="text-body-secondary mb-1">Staff member</p>
    <h1><%= @staff.name %></h1>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "All staff", staffs_path, class: "btn btn-outline-secondary" %>
    <% if policy(@staff).edit? %>
      <%= link_to "Edit staff member", edit_staff_path(@staff), class: "btn btn-primary" %>
    <% end %>
    <% if policy(@staff).destroy? %>
      <%= button_to "Delete staff member", @staff, method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete staff member #{@staff.name}?" } %>
    <% end %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Name</dt>
  <dd class="col-sm-9"><%= @staff.name %></dd>
  <dt class="col-sm-3">Role</dt>
  <dd class="col-sm-9"><%= @staff.role %></dd>
</dl>

<h2 class="h4 mt-5">Repairs taken in</h2>
<% if @intake_repairs.any? %>
  <ul>
    <% @intake_repairs.each do |repair| %>
      <li><%= link_to "Repair ##{repair.id}", repair_path(repair) %></li>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">No repairs were taken in by this staff member.</p>
<% end %>

<h2 class="h4 mt-5">Repairs assigned</h2>
<% if @assigned_repairs.any? %>
  <ul>
    <% @assigned_repairs.each do |repair| %>
      <li><%= link_to "Repair ##{repair.id}", repair_path(repair) %></li>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">No repairs are assigned to this staff member.</p>
<% end %>