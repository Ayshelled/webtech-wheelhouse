<% content_for :title, @customer.name %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="text-body-secondary mb-1">Customer</p>
    <h1><%= @customer.name %></h1>
  </div>
  <%= link_to "All customers", customers_path, class: "btn btn-outline-secondary" %>
</div>

<dl class="row">
  <dt class="col-sm-3">Phone</dt>
  <dd class="col-sm-9"><%= @customer.phone %></dd>
</dl>

<h2 class="h4 mt-5">Bikes</h2>
<% if @customer.bikes.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Bike</th><th>Serial number</th><th></th></tr></thead>
      <tbody><%= render @customer.bikes.order(:make, :model) %></tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">This customer has no bikes.</p>
<% end %>