<% content_for :title, @customer.name %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="text-body-secondary mb-1">Customer</p>
    <h1><%= @customer.name %></h1>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "All customers", customers_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Edit customer", edit_customer_path(@customer), class: "btn btn-primary" %>
    <%= button_to "Delete customer", @customer, method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "Delete customer #{@customer.name}?" } %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Phone</dt>
  <dd class="col-sm-9"><%= @customer.phone %></dd>
</dl>

<h2 class="h4 mt-5">Bikes</h2>
<p><%= link_to "Add a bike for #{@customer.name}", new_bike_path(customer_id: @customer.id), class: "btn btn-outline-primary" %></p>
<% if @customer.bikes.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Bike</th><th>Serial number</th><th></th></tr></thead>
      <tbody><%= render @customer.bikes %></tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">This customer has no bikes.</p>
<% end %>