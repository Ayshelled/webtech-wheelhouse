<% content_for :title, "Customers" %>

<h1>Customers</h1>

<% if @customers.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr><th>Name</th><th>Phone</th></tr>
      </thead>
      <tbody>
        <%= render @customers %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">No customers found.</p>
<% end %>