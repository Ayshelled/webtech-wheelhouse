<% content_for :title, @service_catalog_item.name %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="text-body-secondary mb-1">Service</p>
    <h1><%= @service_catalog_item.name %></h1>
  </div>
  <%= link_to "All services", service_catalog_items_path, class: "btn btn-outline-secondary" %>
</div>

<dl class="row">
  <dt class="col-sm-3">Name</dt>
  <dd class="col-sm-9"><%= @service_catalog_item.name %></dd>
  <dt class="col-sm-3">Price</dt>
  <dd class="col-sm-9"><%= number_to_currency(@service_catalog_item.price) %></dd>
</dl>

<h2 class="h4 mt-5">Repair lines</h2>
<% if @service_catalog_item.repair_line_items.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Repair</th><th>Price charged</th></tr></thead>
      <tbody>
        <% @service_catalog_item.repair_line_items.includes(:repair).each do |line_item| %>
          <tr>
            <td><%= link_to "Repair ##{line_item.repair.id}", repair_path(line_item.repair) %></td>
            <td><%= number_to_currency(line_item.price_charged) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">This service has not been charged on a repair.</p>
<% end %>