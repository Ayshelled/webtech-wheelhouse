<%= form_with model: service_catalog_item do |form| %>
  <%= render "shared/form_errors", record: service_catalog_item %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: field_class(service_catalog_item, :name) %>
    <%= field_error_messages(service_catalog_item, :name) %>
  </div>

  <div class="mb-3">
    <%= form.label :price, class: "form-label" %>
    <%= form.number_field :price, step: "0.01", class: field_class(service_catalog_item, :price) %>
    <%= field_error_messages(service_catalog_item, :price) %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", service_catalog_items_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>