<% content_for :title, "Services" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Services</h1>
  <%= link_to "New service", new_service_catalog_item_path, class: "btn btn-primary" %>
</div>

<% if @service_catalog_items.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Service</th><th>Price</th></tr></thead>
      <tbody><%= render @service_catalog_items %></tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary">No services found.</p>
<% end %>