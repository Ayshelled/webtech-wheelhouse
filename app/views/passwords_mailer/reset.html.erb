<h1>Wheelhouse password reset</h1>
<p>We received a request to reset the password for your Wheelhouse account.</p>
<p>
  <%= link_to "Choose a new password", edit_password_url(@user.password_reset_token) %>.
  This link expires in <%= distance_of_time_in_words(0, @user.password_reset_token_expires_in) %>.
</p>
